/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  color: #262626;
}

/* 全局加载动画 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 70rpx;
  height: 70rpx;
  border: 5rpx solid #e5e5e5;
  border-top: 5rpx solid #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 页面加载骨架屏动画 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 全局按钮样式 */
.btn-primary {
  background: #3B82F6;
  color: #fff;
  border-radius: 16rpx;
  border: none;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #f5f5f5;
  color: #525252;
  border-radius: 24rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #3B82F6;
  border: 1rpx solid #3B82F6;
  border-radius: 24rpx;
}

.btn-outline::after {
  border: none;
}

/* 全局卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.tag-primary {
  background: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
}

.tag-success {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.tag-warning {
  background: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}

.tag-neutral {
  background: #f5f5f5;
  color: #525252;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
}

.input:focus {
  outline: none;
  border-color: #3B82F6;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

/* 全局圆角变量 */
:root {
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
}

/* 全局阴影变量 */
:root {
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

/* 全局颜色变量 */
:root {
  --primary: #3B82F6;
  --primary-dark: #2563EB;
  --primary-light: rgba(59, 130, 246, 0.1);
  --secondary: #60A5FA;
  --success: #10B981;
  --success-light: rgba(16, 185, 129, 0.1);
  --warning: #F59E0B;
  --warning-light: rgba(245, 158, 11, 0.1);
  --danger: #EF4444;
  --danger-light: rgba(239, 68, 68, 0.1);
  --neutral-50: #fafafa;
  --neutral-100: #f5f5f5;
  --neutral-200: #e5e5e5;
  --neutral-300: #d4d4d4;
  --neutral-400: #a3a3a3;
  --neutral-500: #737373;
  --neutral-600: #525252;
  --neutral-700: #404040;
  --neutral-800: #262626;
  --neutral-900: #171717;
}
