<view class="page">
  <view class="content">
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === 'written' ? 'active' : ''}}"
        data-tab="written"
        bindtap="switchTab"
      >
        我写的评价
      </view>
      <view
        class="tab-item {{activeTab === 'received' ? 'active' : ''}}"
        data-tab="received"
        bindtap="switchTab"
      >
        我收到的评价
      </view>
    </view>

    <view wx:if="{{activeTab === 'written'}}">
      <view wx:if="{{writtenReviews.length === 0}}" class="empty-card">
        <text class="empty-text">暂无我写的评价</text>
      </view>
      <view wx:else class="review-list">
        <view wx:for="{{writtenReviews}}" wx:key="id" class="review-card">
          <view class="card-top">
            <view class="order-info">订单 #{{item.orderId}}</view>
            <view class="review-time">{{item.createdAtText}}</view>
          </view>
          <view class="user-row">评价对象：{{item.counterpartName}}</view>
          <view class="order-detail">取件站点：{{item.stationName || '未记录'}}</view>
          <view class="order-detail">送达地点：{{item.deliveryLocation || '未记录'}}</view>
          <view class="rating-row">
            <text class="rating-label">评分</text>
            <view class="star-list">
              <text wx:for="{{item.stars}}" wx:key="value" class="star {{item.active ? 'active' : ''}}">★</text>
            </view>
            <text class="rating-value">{{item.rating}}分</text>
          </view>
          <view class="content-box">{{item.contentText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'received'}}">
      <view wx:if="{{receivedReviews.length === 0}}" class="empty-card">
        <text class="empty-text">暂无我收到的评价</text>
      </view>
      <view wx:else class="review-list">
        <view wx:for="{{receivedReviews}}" wx:key="id" class="review-card">
          <view class="card-top">
            <view class="order-info">订单 #{{item.orderId}}</view>
            <view class="review-time">{{item.createdAtText}}</view>
          </view>
          <view class="user-row">评价人：{{item.counterpartName}}</view>
          <view class="order-detail">取件站点：{{item.stationName || '未记录'}}</view>
          <view class="order-detail">送达地点：{{item.deliveryLocation || '未记录'}}</view>
          <view class="rating-row">
            <text class="rating-label">评分</text>
            <view class="star-list">
              <text wx:for="{{item.stars}}" wx:key="value" class="star {{item.active ? 'active' : ''}}">★</text>
            </view>
            <text class="rating-value">{{item.rating}}分</text>
          </view>
          <view class="content-box">{{item.contentText}}</view>
          <view class="appeal-row">
            <view wx:if="{{item.appealStatus}}" class="appeal-status {{item.appealStatusType}}">
              {{item.appealStatusText}}
            </view>
            <button
              wx:else
              class="appeal-btn"
              data-order-id="{{item.orderId}}"
              bindtap="showAppealModal"
            >
              申诉
            </button>
          </view>
          <view wx:if="{{item.appealResult}}" class="appeal-result">处理结果：{{item.appealResult}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showAppealModal}}" class="modal-mask" catchtouchmove="true">
    <view class="modal-panel">
      <view class="modal-title">提交申诉</view>
      <view class="modal-desc">请填写申诉原因，管理员审核后会给出处理结果。</view>
      <textarea
        class="appeal-textarea"
        placeholder="请输入申诉原因，至少 10 个字"
        maxlength="300"
        value="{{appealReason}}"
        bindinput="onAppealInput"
      />
      <view class="modal-actions">
        <button class="modal-btn cancel-btn" bindtap="hideAppealModal" disabled="{{appealLoading}}">取消</button>
        <button class="modal-btn confirm-btn" bindtap="submitAppeal" loading="{{appealLoading}}" disabled="{{appealLoading}}">
          提交
        </button>
      </view>
    </view>
  </view>
</view>
