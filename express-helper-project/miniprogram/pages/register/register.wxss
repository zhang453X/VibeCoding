.page {
  min-height: 100vh;
  padding: 120rpx 36rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.panel {
  padding: 40rpx 32rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-desc {
  margin-top: 12rpx;
  margin-bottom: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-card {
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.field-input {
  height: 88rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.rule-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.rule-check {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 22rpx;
  color: transparent;
  background: #e2e8f0;
  flex-shrink: 0;
}

.rule-check.checked {
  color: #ffffff;
  background: #2563eb;
}

.rule-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.primary-btn {
  margin-top: 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: none;
  padding: 0;
}

.primary-btn::after {
  border: none;
}

.bottom-bar {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.bottom-text {
  font-size: 26rpx;
  color: #64748b;
}

.bottom-link {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
}
