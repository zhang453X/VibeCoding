.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(90deg, #3B82F6, #2563EB);
  color: white;
}

.back-btn {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.content {
  padding: 20rpx;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
}

.rating-section,
.content-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.star-item {
  padding: 10rpx;
}

.star {
  font-size: 60rpx;
  color: #F59E0B;
}

.rating-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.review-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
  margin-top: 40rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.submit-btn[disabled] {
  opacity: 0.6;
}
