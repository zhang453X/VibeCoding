<view class="page">
  <view class="content">
    <view class="card">
      <view class="rating-section">
        <view class="section-title">服务评分</view>
        <view class="rating-stars">
          <view wx:for="{{5}}" wx:key="index" class="star-item" bindtap="selectRating" data-rating="{{index + 1}}">
            <text class="star">{{index < rating ? '★' : '☆'}}</text>
          </view>
        </view>
        <view class="rating-text">{{ratingText}}</view>
      </view>

      <view class="content-section">
        <view class="section-title">评价内容</view>
        <textarea class="review-textarea" placeholder="请输入您的评价内容..." value="{{content}}" bindinput="onContentInput" maxlength="500" />
        <view class="char-count">{{content.length}}/500</view>
      </view>

      <button class="submit-btn" bindtap="submitReview" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '确认收到'}}
      </button>
    </view>
  </view>
</view>
