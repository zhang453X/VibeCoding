.page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.content {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding: 0 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.panel {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.34);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow:
    0 24rpx 60rpx rgba(15, 23, 42, 0.22),
    0 8rpx 20rpx rgba(255, 255, 255, 0.1) inset;
}

.section-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 1rpx;
}

.section-desc {
  margin-top: 12rpx;
  margin-bottom: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #111827;
}

.field-card {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.field-input {
  height: 88rpx;
  font-size: 28rpx;
  color: #111827;
}

.field-placeholder {
  color: #111827;
}

.primary-btn {
  margin-top: 12rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.92), rgba(59, 130, 246, 0.88));
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.28);
  padding: 0;
}

.primary-btn::after {
  border: none;
}

.bottom-bar {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.bottom-text {
  font-size: 26rpx;
  color: rgba(17, 24, 39, 0.78);
}

.bottom-link {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}
