.page {
  min-height: 100vh;
  background: #f5f7fb;
  display: flex;
  flex-direction: column;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.header-safe {
  width: 100%;
}

.header-main,
.title-block,
.toolbar,
.card-title-row,
.card-title,
.card-meta-row {
  display: flex;
}

.header-main {
  justify-content: space-between;
  align-items: flex-start;
  padding: 18rpx 24rpx 0;
}

.title-block {
  flex-direction: column;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  color: #111827;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.header-status {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  font-size: 22rpx;
  color: #64748b;
}

.toolbar {
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 0 24rpx 18rpx;
}

.toolbar-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  font-size: 24rpx;
  color: #64748b;
}

.toolbar-btn.primary {
  background: rgba(59, 130, 246, 0.12);
  color: #3b82f6;
}

.toolbar-btn.danger {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.main-content {
  flex: 1;
  height: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a3a3a3;
}

.message-list {
  padding: 16rpx 12rpx 24rpx;
}

.message-item {
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
}

.message-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
}

.message-track {
  display: flex;
  transition: transform 0.3s;
}

.message-main {
  flex: 0 0 auto;
}

.card {
  background: #ffffff;
  margin: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  transition: all 0.3s;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  min-height: 80rpx;
}

.card.unread {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.06) 0%, rgba(59, 130, 246, 0.02) 100%);
}

.card.selected {
  background: #eef6ff;
}

.checkbox {
  padding: 12rpx 0 12rpx 18rpx;
  display: flex;
  align-items: center;
}

.checkbox-inner {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: transparent;
  transition: all 0.3s;
}

.checkbox-inner.checked {
  background: #3B82F6;
  border-color: #3B82F6;
  color: #ffffff;
}

.card-content {
  flex: 1;
  padding: 10rpx 18rpx;
  padding-left: 18rpx;
}

.card-top {
  margin-bottom: 4rpx;
}

.card-title-row {
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.card-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  align-items: center;
  gap: 6rpx;
}

.card-time {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #94a3b8;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d4f;
  flex-shrink: 0;
}

.card-meta-row {
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.notice-type {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  font-size: 20rpx;
  color: #64748b;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.content {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.35;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-tag {
  font-size: 20rpx;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.slide-actions {
  display: flex;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 0 22rpx 22rpx 0;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.slide-btn {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #ffffff;
  min-height: 100%;
  line-height: 1;
  text-align: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.unread-btn {
  background: #f59e0b;
}

.unread-btn.disabled {
  background: #cbd5e1;
}

.delete-btn {
  background: #ef4444;
}
