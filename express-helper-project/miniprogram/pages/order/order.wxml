<view class="page">
  <scroll-view class="main-content" scroll-y="true">
    <view class="category-bar">
      <scroll-view scroll-x="true" class="category-scroll">
        <view class="category-list">
          <view class="category-item {{currentStatus === 'all' ? 'active' : ''}}" bindtap="switchStatus" data-status="all">全部</view>
          <view class="category-item {{currentStatus === 'toPickup' ? 'active' : ''}}" bindtap="switchStatus" data-status="toPickup">待取件</view>
          <view class="category-item {{currentStatus === 'toDeliver' ? 'active' : ''}}" bindtap="switchStatus" data-status="toDeliver">待配送</view>
          <view class="category-item {{currentStatus === 'COMPLETED' ? 'active' : ''}}" bindtap="switchStatus" data-status="COMPLETED">已完成</view>
        </view>
      </scroll-view>
    </view>

    <view class="task-list">
      <view wx:if="{{filteredList.length===0}}" class="empty">
        <text class="empty-title">暂无任务</text>
        <text class="empty-desc">当前分类下还没有配送任务，去抢单大厅看看新的待抢订单吧。</text>
        <button class="empty-btn" bindtap="goToHall">去抢单</button>
      </view>

      <block wx:for="{{filteredList}}" wx:key="id">
        <view class="task-card" data-id="{{item.id}}" bindtap="viewOrderDetail">
          <view class="card-top">
            <view class="user-info">
              <view class="user-avatar">{{item._publisherShort}}</view>
              <view class="user-detail">
                <view class="user-name">{{item._publisherName}}</view>
                <view class="publish-time">{{item._timeText}}</view>
              </view>
            </view>
            <text class="type-tag {{item._typeClass}}">{{item._typeLabel}}</text>
          </view>

          <view class="route-row">
            <view class="route-text">
              <text class="route-name">{{item.stationName || '待补充'}}</text>
              <text class="route-arrow">→</text>
              <text class="route-name">{{item.deliveryLocation || '待补充'}}</text>
            </view>
            <text class="status-pill {{item._statusClass}}">{{item._statusLabel}}</text>
          </view>

          <view class="meta-row">
            <text wx:if="{{item.pickupTimeRange}}" class="meta-pill">{{item.pickupTimeRange}}</text>
            <text wx:if="{{item.expressCompany}}" class="meta-pill">{{item.expressCompany}}</text>
            <text wx:if="{{item.expressNo}}" class="meta-pill">单号 {{item.expressNo}}</text>
          </view>

          <view class="remark-text">{{item.remark || '点击卡片查看完整订单详情和处理进度。'}}</view>

          <view class="card-bottom">
            <view class="fee-info">
              <text class="fee-label">报酬</text>
              <text class="fee-text">¥{{item._feeText}}</text>
            </view>
            <view class="action-buttons" catchtap="stopPropagation">
              <button class="action-btn action-outline" size="mini" bindtap="contactUser" data-phone="{{item.contactPhone}}" wx:if="{{item.contactPhone && item.status !== 'COMPLETED'}}">联系发布者</button>
              <button class="action-btn action-primary" size="mini" data-id="{{item.id}}" data-status="DELIVERING" bindtap="updateStatus" wx:if="{{item.status==='GRABBED'}}">确认取件</button>
              <button class="action-btn action-primary" size="mini" data-id="{{item.id}}" data-status="COMPLETED" bindtap="updateStatus" wx:if="{{item.status==='PICKED_UP' || item.status==='DELIVERING'}}">完成订单</button>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
