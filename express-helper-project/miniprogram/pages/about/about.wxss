.page {
  min-height: 100vh;
  background: #f5f7fb;
}

.content {
  padding: 28rpx 24rpx 40rpx;
}

.hero-card,
.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.05);
}

.hero-card {
  margin-bottom: 24rpx;
}

.hero-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.hero-name {
  margin-top: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2563eb;
}

.hero-intro {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #4b5563;
  text-align: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.info-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.info-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.info-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

.info-action {
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
