<view class="page">
  <view class="content">
    <view wx:if="{{records.length === 0}}" class="empty">
      <text>暂无积分记录</text>
    </view>
    <view wx:else class="record-list">
      <view wx:for="{{records}}" wx:key="id" class="record-item">
        <view class="record-info">
          <view class="record-reason">{{item.reason}}</view>
          <view class="record-time">{{item.createdAt}}</view>
        </view>
        <view class="record-score {{item.scoreChange > 0 ? 'positive' : 'negative'}}">
          {{item.scoreChange > 0 ? '+' : ''}}{{item.scoreChange}}
        </view>
      </view>
    </view>
  </view>
</view>
