.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(90deg, #3B82F6, #2563EB);
  color: white;
}

.back-btn {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.content {
  padding: 20rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  border-radius: 16rpx;
}

.record-info {
  flex: 1;
}

.record-reason {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-score {
  font-size: 36rpx;
  font-weight: 600;
}

.record-score.positive {
  color: #10B981;
}

.record-score.negative {
  color: #EF4444;
}
