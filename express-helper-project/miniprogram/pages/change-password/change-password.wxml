<view class="page">
  <view class="content">
    <view class="intro-card">
      <view class="page-title">修改密码</view>
      <view class="page-desc">为了账号安全，修改成功后需要重新登录。</view>
    </view>

    <view class="form-card">
      <view class="form-item">
        <text class="label">原密码</text>
        <input
          class="form-input"
          placeholder="请输入当前密码"
          password="{{true}}"
          value="{{form.oldPassword}}"
          data-key="oldPassword"
          bindinput="setField"
        />
      </view>
      <view class="form-item">
        <text class="label">新密码</text>
        <input
          class="form-input"
          placeholder="请输入 6-20 位新密码"
          password="{{true}}"
          maxlength="20"
          value="{{form.newPassword}}"
          data-key="newPassword"
          bindinput="setField"
        />
      </view>
      <view class="form-item no-border">
        <text class="label">确认新密码</text>
        <input
          class="form-input"
          placeholder="请再次输入新密码"
          password="{{true}}"
          maxlength="20"
          value="{{form.confirmPassword}}"
          data-key="confirmPassword"
          bindinput="setField"
        />
      </view>
    </view>

    <view class="tips-card">
      <view class="tips-title">密码要求</view>
      <view class="tips-text">1. 密码长度需为 6-20 位</view>
      <view class="tips-text">2. 新密码不能与原密码相同</view>
      <view class="tips-text">3. 修改后请使用新密码重新登录</view>
    </view>

    <button class="submit-btn" bindtap="changePassword" loading="{{loading}}" disabled="{{loading}}">
      <text>确认修改</text>
    </button>
  </view>
</view>
