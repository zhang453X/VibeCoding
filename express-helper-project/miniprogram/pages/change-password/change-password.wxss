.page {
  min-height: 100vh;
  background: #f5f7fb;
  box-sizing: border-box;
}

.content {
  padding: 28rpx 24rpx 40rpx;
}

.intro-card,
.form-card,
.tips-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.05);
}

.intro-card {
  padding: 32rpx 28rpx;
}

.page-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #111827;
  text-align: center;
}

.page-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
  text-align: center;
}

.form-card {
  margin-top: 24rpx;
  padding: 0 28rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.form-item.no-border {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #374151;
}

.form-input {
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.tips-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.tips-title {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #111827;
}

.tips-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #6b7280;
}

.submit-btn {
  height: 92rpx;
  margin-top: 32rpx;
  border: none;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 32rpx rgba(59, 130, 246, 0.2);
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.submit-btn::after {
  border: none;
}
