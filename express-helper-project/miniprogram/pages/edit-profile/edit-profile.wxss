.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

input {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  color: #262626;
}

input:focus {
  border-color: #3B82F6;
  background: #fff;
}

input[disabled] {
  background: #f0f0f0;
  color: #999;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
  margin-top: 20rpx;
}

.save-btn::after {
  border: none;
}
