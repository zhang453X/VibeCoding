<view class="page">
  <view class="header">
    <view class="title">发布历史记录</view>
  </view>
  
  <view wx:if="{{list.length===0}}" class="empty">暂无发布记录</view>
  <block wx:for="{{list}}" wx:key="id">
    <view class="card" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-id">订单号：{{item.id}}</view>
        <view class="order-status status-{{item.status}}">{{statusMap[item.status]}}</view>
      </view>
      <view class="order-info">
        <view>站点：{{item.stationName}}</view>
        <view>送达：{{item.deliveryLocation}}</view>
        <view>费用：¥{{item.fee}}</view>
        <view wx:if="{{item.expressCompany}}">快递：{{item.expressCompany}}</view>
        <view wx:if="{{item.pickupTimeRange}}">送达时间：{{item.pickupTimeRange}}</view>
      </view>
      <view class="actions" catchtap="stopPropagation">
        <button size="mini" data-id="{{item.id}}" data-status="PICKED_UP" bindtap="updateStatus" wx:if="{{item.status==='GRABBED'}}">确认取件</button>
        <button size="mini" data-id="{{item.id}}" data-status="COMPLETED" bindtap="updateStatus" wx:if="{{item.status==='DELIVERING'}}">确认完成</button>
        <button size="mini" type="primary" bindtap="showRatingModal" data-index="{{index}}" wx:if="{{item.status==='COMPLETED' && !item.rated}}">评价</button>
        <button size="mini" disabled wx:if="{{item.rated}}">已评价</button>
        <button size="mini" data-id="{{item.id}}" bindtap="cancelOrder" wx:if="{{item.status==='PENDING_GRAB'}}">取消</button>
        <button wx:if="{{(item.status==='CANCELLED' || item.status==='CANCELED') && !item.republished}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="republishOrder">重新发布</button>
        <button wx:elif="{{(item.status==='CANCELLED' || item.status==='CANCELED') && item.republished}}" size="mini" disabled type="default">已重新发布</button>
      </view>
    </view>
  </block>
  
  <!-- 评价弹窗 -->
  <view class="rating-modal {{showRatingModal ? 'active' : ''}}" wx:if="{{showRatingModal}}">
    <view class="modal-mask" bindtap="hideRatingModal"></view>
    <view class="modal-content">
      <view class="modal-title">订单评价</view>
      <view class="rating-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{rating >= item ? 'active' : ''}}" bindtap="setRating" data-rating="{{item}}">★</text>
      </view>
      <textarea placeholder="请输入评价内容" value="{{ratingContent}}" bindinput="onRatingInput" maxlength="200" />
      <view class="modal-buttons">
        <button size="mini" bindtap="hideRatingModal">取消</button>
        <button size="mini" type="primary" bindtap="submitRating" loading="{{ratingLoading}}">提交</button>
      </view>
    </view>
  </view>
</view>
