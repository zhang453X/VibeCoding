.page {
  padding: 20rpx;
  background: #f5f7fb;
  min-height: 100vh;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-PENDING_GRAB {
  background: #f0f0f0;
  color: #666;
}

.status-GRABBED {
  background: #e6f7ff;
  color: #1890ff;
}

.status-PICKED_UP {
  background: #fff7e6;
  color: #fa8c16;
}

.status-DELIVERING {
  background: #f6ffed;
  color: #52c41a;
}

.status-COMPLETED {
  background: #e6fffb;
  color: #13c2c2;
}

.status-CANCELLED, .status-CANCELED {
  background: #fff1f0;
  color: #f5222d;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.empty {
  color: #888;
  text-align: center;
  margin-top: 100rpx;
}

/* 评价弹窗样式 */
.rating-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.rating-modal.active {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 1001;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.star {
  font-size: 48rpx;
  color: #e0e0e0;
  transition: all 0.2s;
}

.star.active {
  color: #ffd700;
  transform: scale(1.1);
}

textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
  margin-bottom: 24rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.modal-buttons button {
  flex: 1;
  border-radius: 12rpx;
}
