.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-card,
.map-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
}

.map-card {
  margin-top: 20rpx;
}

.station-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.station-area {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
  font-size: 22rpx;
}

.station-address {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
}

.meta-list {
  margin-top: 24rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #94a3b8;
}

.meta-value {
  text-align: right;
  font-size: 24rpx;
  color: #111827;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 18rpx;
}

.map-image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.map-tip {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3b82f6;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #67c9f5, #3b82f6);
  color: #ffffff;
}

.action-btn::after {
  border: none;
}
