<view class="page">
  <view class="page-header">
    <text class="page-title">校内快递点</text>
    <text class="page-subtitle">查看校内快递点位置并进入详情页查看地图</text>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-card">
    <text class="empty-title">暂无快递点数据</text>
    <text class="empty-desc">请先到管理员端新增快递点信息</text>
  </view>

  <view class="station-list">
    <view class="station-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="station-top">
        <view>
          <text class="station-name">{{item.stationName}}</text>
          <text class="station-area" wx:if="{{item.campusArea}}">{{item.campusArea}}</text>
        </view>
        <text class="station-link">查看位置 ></text>
      </view>
      <text class="station-address">{{item.detailAddress}}</text>
      <view class="station-meta">
        <text wx:if="{{item.serviceTime}}" class="meta-pill">营业时间 {{item.serviceTime}}</text>
        <text wx:if="{{item.contactPhone}}" class="meta-pill">电话 {{item.contactPhone}}</text>
      </view>
      <text wx:if="{{item.description}}" class="station-desc">{{item.description}}</text>
    </view>
  </view>
</view>
