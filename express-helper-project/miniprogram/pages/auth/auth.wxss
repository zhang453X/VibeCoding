.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: #f5f7fb;
}

.status-card,
.form-box {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
}

.status-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-title-wrap {
  flex: 1;
  text-align: center;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.card-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #94a3b8;
}

.status-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.idle {
  background: #eff6ff;
  color: #2563eb;
}

.status-badge.pending {
  background: #fff7ed;
  color: #d97706;
}

.status-badge.approved {
  background: #ecfdf5;
  color: #059669;
}

.status-badge.rejected {
  background: #fef2f2;
  color: #dc2626;
}

.status-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
}

.status-panel.idle {
  background: #eff6ff;
}

.status-panel.pending {
  background: #fff7ed;
}

.status-panel.approved {
  background: #ecfdf5;
}

.status-panel.rejected {
  background: #fef2f2;
}

.status-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.status-pass-image {
  width: 60rpx;
  height: 60rpx;
}

.status-panel.idle .status-icon {
  background: #3b82f6;
}

.status-panel.pending .status-icon {
  background: #f59e0b;
}

.status-panel.approved .status-icon {
  background: transparent;
}

.status-panel.rejected .status-icon {
  background: #ef4444;
}

.status-content {
  flex: 1;
}

.status-heading {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #475569;
}

.reject-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fff7f7;
  border: 1rpx solid #fecaca;
}

.reject-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #dc2626;
}

.reject-reason {
  font-size: 24rpx;
  line-height: 1.7;
  color: #7f1d1d;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #94a3b8;
}

.form-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-item {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.form-input {
  height: 46rpx;
  font-size: 28rpx;
  color: #111827;
}

.upload-section {
  margin-top: 26rpx;
}

.upload-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.upload-area {
  width: 100%;
  height: 280rpx;
  border: 2rpx dashed #dbeafe;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fbff;
  overflow: hidden;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 38rpx;
  color: #2563eb;
  background: rgba(59, 130, 246, 0.12);
}

.upload-text {
  font-size: 24rpx;
  color: #64748b;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.submit-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.submit-btn,
.refresh-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}

.submit-btn {
  margin-top: 24rpx;
  border: none;
  background: #2563eb;
  color: #ffffff;
}

.submit-btn::after,
.refresh-btn::after {
  border: none;
}

.refresh-btn {
  border: 1rpx solid #dbeafe;
  background: #ffffff;
  color: #2563eb;
}
