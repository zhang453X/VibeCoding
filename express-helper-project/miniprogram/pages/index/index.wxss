.page-container {
  min-height: 100vh;
  background: #f5f7fb;
  color: #1f2937;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  height: 0;
}

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.header-safe {
  width: 100%;
}

.header-content,
.header-actions,
.feature-grid,
.feature-item,
.quick-banner,
.task-list-header,
.card-header,
.user-info,
.card-footer,
.reward-info,
.route-card,
.route-content,
.hero-actions {
  display: flex;
}

.header-content,
.task-list-header,
.card-header,
.card-footer,
.quick-banner {
  justify-content: space-between;
  align-items: center;
}

.header-actions {
  gap: 10rpx;
}

.header-content {
  padding: 8rpx 18rpx 10rpx;
  justify-content: flex-start;
  align-items: center;
}

.icon-btn,
.message-btn {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-image {
  width: 34rpx;
  height: 34rpx;
}

.message-dot {
  position: absolute;
  top: 0;
  right: -2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  border: 2rpx solid #ffffff;
}

.hero-btn::after,
.accept-btn::after {
  border: none;
}

.hero-card {
  position: relative;
  margin: 24rpx 24rpx 20rpx;
  height: 290rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(59, 130, 246, 0.12);
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-swiper,
.hero-image,
.hero-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.78), rgba(59, 130, 246, 0.2));
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx;
  max-width: 460rpx;
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  line-height: 1.6;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero-actions {
  margin-top: 28rpx;
  margin-left: 18rpx;
  justify-content: flex-start;
  gap: 0;
}

.hero-btn {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 56rpx;
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 0 40rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.hero-btn-primary {
  background: #ffffff;
  color: #3b82f6;
}

.hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 1;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.dot.active {
  background: #ffffff;
}

.feature-grid {
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 8rpx 32rpx 20rpx;
}

.feature-item {
  width: 25%;
  flex-direction: column;
  align-items: center;
}

.feature-image {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 14rpx;
}

.feature-name {
  font-size: 24rpx;
  color: #475569;
}

.quick-banner {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #67c9f5, #3b82f6);
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(59, 130, 246, 0.16);
}

.quick-banner-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.quick-banner-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quick-banner-title {
  font-size: 30rpx;
  font-weight: 600;
}

.quick-banner-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.quick-banner-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.tip-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #c2410c;
}

.tip-content {
  display: block;
  margin-top: 10rpx;
  line-height: 1.6;
  font-size: 24rpx;
  color: #9a3412;
}

.task-section {
  padding-bottom: 32rpx;
}

.category-tabs-wrapper {
  padding: 0 0 12rpx;
}

.category-tabs {
  white-space: nowrap;
}

.category-tab {
  display: inline-block;
  margin-left: 24rpx;
  padding: 6rpx 0 14rpx;
  font-size: 27rpx;
  color: #94a3b8;
  border-bottom: 4rpx solid transparent;
}

.category-tab:first-child {
  margin-left: 28rpx;
}

.category-tab.active {
  color: #3b82f6;
  font-weight: 600;
  border-bottom-color: #3b82f6;
}

.task-list-wrapper {
  padding: 0 24rpx;
}

.task-list-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.task-list-count {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.view-more {
  font-size: 24rpx;
  color: #60a5fa;
}

.state-card {
  margin-top: 18rpx;
  padding: 40rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.task-card {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #60a5fa, #3b82f6);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.post-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.type-normal {
  background: #eff6ff;
  color: #3b82f6;
}

.type-fresh {
  background: #ecfeff;
  color: #0891b2;
}

.type-file {
  background: #f5f3ff;
  color: #8b5cf6;
}

.type-large {
  background: #eef2ff;
  color: #6366f1;
}

.route-card {
  align-items: flex-start;
  margin-top: 18rpx;
}

.route-point {
  width: 18rpx;
  height: 18rpx;
  margin: 10rpx 18rpx 0 0;
  border-radius: 50%;
  flex-shrink: 0;
}

.route-start {
  background: #3b82f6;
}

.route-end {
  background: #10b981;
}

.route-content {
  flex: 1;
  flex-direction: column;
}

.route-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.route-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.meta-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  font-size: 22rpx;
  color: #64748b;
}

.remark-text {
  margin-top: 18rpx;
  line-height: 1.6;
  font-size: 24rpx;
  color: #64748b;
}

.reward-label {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.reward-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #f59e0b;
}

.accept-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #67c9f5, #3b82f6);
  color: #ffffff;
  font-size: 26rpx;
  box-shadow: 0 12rpx 24rpx rgba(59, 130, 246, 0.2);
}
